{
  "Remove": [
    {
      "DisplayName": "Notepad++ (64-bit x64)"
    },
    {
      "DisplayName": "Example Vendor Tool*",
      "UninstallArguments": "/S",
      "Comment": "* matches any text, so every version is removed. /S makes this uninstaller silent; it is added to the uninstall command in the registry."
    },
    {
      "DisplayName": "Example Old Agent",
      "UninstallCommand": "\"C:\\Program Files\\Example Old Agent\\uninstall.exe\" /quiet",
      "SuccessExitCodes": [0, 1],
      "Comment": "UninstallCommand replaces the uninstall command in the registry."
    }
  ],
  "Install": [
    {
      "ExecutablePath": "Software\\npp.8.3.3.Installer.x64.exe",
      "Arguments": "/S"
    },
    {
      "ExecutablePath": "Software\\MicrosoftEdgeSetup.exe",
      "Arguments": null
    },
    {
      "ExecutablePath": "Software\\Remote Access-windows64-offline.exe",
      "Arguments": null
    },
    {
      "ExecutablePath": "Software\\Remote Access-windows64-offline.exe",
      "Arguments": "/S /NAME=AUTODETECT \"/HOST=http://5.5.5.5:10555\""
    },
    {
      "ExecutablePath": "Software\\Firebird-2.1.3.18185_0_x64.exe",
      "Arguments": "/Silent",
      "SuccessExitCodes": [0, 1],
      "Comment": "This installer returns 1 when Firebird is already installed, which is fine. 3010 and 1641 (restart needed) always count as success."
    },
    {
      "ExecutablePath": "Software\\cscript.exe",
      "Arguments": "DELL_COMMANDUPDATE_4.2.1_EN_X86_R02417\\_Install_Silent.vbs"
    }
  ],
  "Comment": "Place installers in Software. Review uninstall names and installation arguments."
}

[
  {
    "Name": "Data",
    "Path": "C:\\Data",
    "Description": "Shared data",
    "Access": [
      {
        "AccountName": "BUILTIN\\Administrators",
        "AccessControlType": "Allow",
        "AccessRight": "Full",
        "Comment": "The English name of a built-in group: a restore uses the name of its Windows language"
      },
      {
        "AccountName": "NT AUTHORITY\\Authenticated Users",
        "AccessControlType": "Allow",
        "AccessRight": "Change"
      },
      {
        "AccountName": "BUILTIN\\Guests",
        "AccessControlType": "Deny",
        "AccessRight": "Full",
        "Comment": "Guests are denied"
      }
    ],
    "NTFS": {
      "Owner": "BUILTIN\\Administrators",
      "AreAccessRulesProtected": false,
      "Access": [
        {
          "IdentityReference": "BUILTIN\\Users",
          "AccessControlType": "Allow",
          "FileSystemRights": "Modify, Synchronize",
          "InheritanceFlags": "ContainerInherit, ObjectInherit",
          "PropagationFlags": "None"
        }
      ]
    },
    "Comment": "Export an existing share to capture its settings and permissions. Built-in accounts get their English name, which works in every Windows language."
  },
  {
    "Name": "Scans",
    "Path": "D:\\Scans",
    "Description": "Scanned documents",
    "Access": [
      {
        "AccountName": "BUILTIN\\Users",
        "AccessControlType": "Allow",
        "AccessRight": "Read"
      },
      {
        "AccountName": "CONTOSO\\Scanner service",
        "AccessControlType": "Allow",
        "AccessRight": "Change"
      }
    ],
    "ConcurrentUserLimit": "{{number:Maximum number of users of the Scans share, 0 for no limit}}",
    "Comment": "Without NTFS, the permissions of the folder itself are left unchanged. {{number:...}} asks for the user limit at restore time."
  }
]
